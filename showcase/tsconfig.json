{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["vite/client", "node"],
        "baseUrl": ".",
        "paths": {
            "agent-chatbox": [
                "../src"
            ],
            "@/*": [
                "../src/*"
            ]
        }
    },
    "include": [
        ".",
        "../src"
    ]
}